{
  "manifest_version": 3,
  "name": "Live Radar — Twitch e YouTube",
  "version": "1.0.0",
  "description": "Avise quando seus streamers entrarem ao vivo e escolha ignorar, abrir sem áudio ou assistir.",
  "permissions": ["storage", "alarms", "notifications", "tabs", "identity"],
  "host_permissions": ["https://api.twitch.tv/*", "https://id.twitch.tv/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Live Radar", "default_icon": "icons/icon128.png" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{ "matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }]
}
